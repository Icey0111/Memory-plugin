{
  "package": "aetheria-unified-memory-v5_4",
  "version": "5.4.0",
  "architecture": "v5.4 runtime + v5.5-dev A+B+C+D+E+F+G: plugin-owned Setting Store/import/shared retrieval/context plane with per-entry incremental Setting Vector lifecycle, embedding-profile isolation, safe staging/verification and dual Reference/Current-State injection; Commit H live acceptance is next",
  "reference_design": "LittleWhiteBox public docs/repository concepts; independent implementation",
  "baseline_policy": {
    "stable_vector_sources": [
      "persona",
      "character_description",
      "character_personality",
      "character_scenario",
      "persona_worldbook",
      "character_worldbook",
      "chat_worldbook"
    ],
    "volatile_lexical_only_sources": [
      "active_world_info"
    ],
    "does_not_scan_all_account_lorebooks": true
  },
  "setting_import_policy": {
    "two_phase_preview_commit": true,
    "formats": [
      "worldbook_json",
      "titled_txt"
    ],
    "unknown_entry_fields_preserved": true,
    "exact_source_text_preserved": true,
    "duplicate_identity": "content_hash"
  },
  "setting_index_policy": {
    "scope": "world_id + active baseline revision + compatible active extension revisions",
    "chat_id_in_collection_identity": false,
    "structured_parent_linked_chunks": true,
    "lexical_fallback_always_local": true,
    "optional_vector_projection": true,
    "derived_state_location": "extension settings",
    "generation_retrieval_wired": true,
    "generation_main_prompt_injection_wired": true,
    "extractor_retrieval_wired": true,
    "plugin_setting_baseline_dedup": true,
    "retrieval_fusion": "lexical + optional dense -> RRF -> parent expansion -> entry dedup -> budget",
    "incremental_per_entry_vector_diff": true,
    "embedding_profile_in_collection_identity": true,
    "safe_staging_verify_switch": true,
    "purge_active_before_rebuild": false,
    "retired_collection_auto_gc": false,
    "state_schema_version": 2
  },
  "context_injection_policy": {
    "assembler": "context-assembler.js",
    "reference_prompt_key": "aetheria_unified_memory_v5_4_reference",
    "reference_role": "system",
    "reference_default_depth": 4,
    "reference_contains": [
      "bounded constant/core setting",
      "relevant setting",
      "historical memory"
    ],
    "current_state_prompt_key": "aetheria_unified_memory_v5_4_current_state",
    "current_state_role": "system",
    "current_state_default_depth": 1,
    "current_state_contains": [
      "last completed turn active_state",
      "active slots/current truth"
    ],
    "legacy_prompt_key_cleanup_only": "aetheria_unified_memory_v5_4",
    "mutates_real_chat": false,
    "quiet_impersonate_disable_chat_switch_cleanup": true,
    "imported_instruction_text_is_data": true
  },
